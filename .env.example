# ─────────────────────────────────────────────
#  ATBot — Environment Configuration Template
#  Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_random_secret_key

# ── Database ─────────────────────────────────
# SQLite for local dev (no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./atbot.db

# PostgreSQL for production (uncomment when deploying)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/atbot

# ── Free API Keys ─────────────────────────────
# Finnhub (free: 60 calls/min) → https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key

# NewsAPI (free: 100 calls/day) → https://newsapi.org
NEWSAPI_KEY=your_newsapi_key

# Financial Modeling Prep (free: 250 calls/day) → https://financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key

# ── Email Alerts ──────────────────────────────
ALERT_EMAIL_FROM=atbot.alerts@gmail.com
ALERT_EMAIL_TO=your.email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=atbot.alerts@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# ── Scoring Weights ───────────────────────────
# Must sum to 1.0
WEIGHT_TECHNICAL=0.45
WEIGHT_FUNDAMENTAL=0.30
WEIGHT_SENTIMENT=0.25

# ── Scheduler ────────────────────────────────
# Cron expressions (IST)
MARKET_DATA_INTERVAL_MINUTES=5
NEWS_REFRESH_INTERVAL_MINUTES=10
FUNDAMENTALS_REFRESH_HOUR=18       # 6 PM IST daily
MORNING_BRIEFING_HOUR=8
MORNING_BRIEFING_MINUTE=45

# ── Market Config ─────────────────────────────
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=15
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
MARKET_TIMEZONE=Asia/Kolkata
